import ifj26.*

def factorial(n : Int) : Int =
    if n <= 1 then
        1
    else
        n * factorial(n - 1)

def power(base : Double, exp : Int) : Double =
    var res : Double = 1.0
    var i : Int = 0
    while i < exp do
        res = res * base
        i = i + 1
    res

def complex_math(a : Int, b : Double, c : Int) : Double =
    val temp1 = a * 2 + c
    val temp2 = b / 2.0 - 1.5
    var result : Double = (temp1 + temp2) * (b - 0.5)
    if result > 100.0 then
        result = result / 2.0
    else
        result = result + 50.0
    result

@main
def main() : Unit =
    val text1 = "IFJ26 # \"nechutny\" test \\\n"
    print(text1)

    val f5 = factorial(5)
    print(f5)

    val p = power(2.5, 3)
    print(p)

    val c_res = complex_math(10, 4.0, 5)
    print(c_res)

    var count : Int = 3
    while count > 0 do
        var inner_var : Int = count * 10
        if inner_var >= 20 then
            val msg1 = "Vacsia vetva: "
            print(msg1)
            print(inner_var)
        else
            val msg2 = "Mensa vetva: "
            print(msg2)
            print(inner_var)
        count = count - 1

    val str = "Ahoj Svet"
    val len = strLength(str)
    val ascii_A = ord(str, 0)
    val sub = subStr(str, 0, 4)
    print(len)
    print(ascii_A)
    print(sub)

import ifj26.*

@main def main(): Unit =
    var sum = 0
    var i = 1
    while i <= 4 do
        val sq = i * i
        sum = sum + sq
        i = i + 1
    val x: Int = 100
    if sum > 10 then
        val x: String = "inner"
        print(x)
    else
        ()
    val y = x + 5
    print("|")
    print(sum)
    print("|")
    print(y)

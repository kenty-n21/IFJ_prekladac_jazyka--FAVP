import ifj26.*

/* vnoreny /* blokovy */ komentar na jednom riadku */
def addTen(x: Int) = x + 10

def sumThree(
  a: Int,
  b: Int,
  c: Int,
): Int =
  a + b + c

def discardReturn(): Unit =
  print("side_effect|")
  return 999

@main def main(): Unit =
  val a: Int = addTen(5)
  val b: Int = sumThree(
    1,
    2,
    3,
  )
  val u: Unit = discardReturn()
  print(a)
  print("|")
  print(b)
  print("|")
  print(u)
  print("\n")

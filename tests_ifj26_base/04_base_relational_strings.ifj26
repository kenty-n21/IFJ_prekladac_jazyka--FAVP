import ifj26.*

@main def main(): Unit =
  val i: Int = 5
  val d: Double = 5.0
  if i == d then
    if 4 < 4.5 then
      print("num_ok|")
    else
      print("num_fail|")
  else
    print("eq_fail|")

  val s1: String = "abc"
  val s2: String = "abd"
  if s1 < s2 then
    if s1 != s2 then
      print("str_ok|")
    else
      print("str_fail|")
  else
    print("str_fail|")

  val esc: String = "A\t\"B\"\\C"
  val raw: String = """X
Y\nZ"""
  val joined: String = esc + "|" + raw
  print(joined)
  print("\n")

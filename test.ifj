<?xml version="1.0" encoding="UTF-8"?>
<!-- Referencny priklad pre: if (x == 0) { y = 1 } -->
<program language="IPPcode21">
    <!-- 1. Deklaracia premennych x a y -->
    <instruction order="1" opcode="DEFVAR">
        <arg1 type="var">GF@x</arg1>
    </instruction>
    <instruction order="2" opcode="DEFVAR">
        <arg1 type="var">GF@y</arg1>
    </instruction>

    <!-- 2. Inicializacia x = 0 (aby podmienka platila) -->
    <instruction order="3" opcode="MOVE">
        <arg1 type="var">GF@x</arg1>
        <arg2 type="int">0</arg2>
    </instruction>

    <!-- 3. Podmienka: ak x != 0, preskoc blok if na navestie endif -->
    <instruction order="4" opcode="JUMPIFNEQ">
        <arg1 type="label">endif</arg1>
        <arg2 type="var">GF@x</arg2>
        <arg3 type="int">0</arg3>
    </instruction>

    <!-- 4. Telo podmienky: y = 1 -->
    <instruction order="5" opcode="MOVE">
        <arg1 type="var">GF@y</arg1>
        <arg2 type="int">1</arg2>
    </instruction>

    <!-- 5. Navestie konca podmienky -->
    <instruction order="6" opcode="LABEL">
        <arg1 type="label">endif</arg1>
    </instruction>

    <!-- 6. Overenie vysledku: vypise hodnotu y (1) -->
    <instruction order="7" opcode="WRITE">
        <arg1 type="var">GF@y</arg1>
    </instruction>
</program>